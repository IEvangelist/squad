---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const base = import.meta.env.BASE_URL;
const posts = await getCollection('blog');

// Sort by filename (which is chronologically ordered by the number prefix)
posts.sort((a, b) => b.id.localeCompare(a.id));

function extractTitle(id: string): string {
  return id
    .replace(/^\d+[a-z]?-/, '')
    .replace(/-/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
}
---

<BaseLayout title="Blog">
  <Header />
  <main id="main-content" class="container-lg px-3 px-md-4 py-5" tabindex="-1">
    <h1 class="f0-ish mb-2">Blog</h1>
    <p class="f3 color-fg-muted mb-5">Stories from the Squad development journey — releases, learnings, and the road ahead.</p>

    <ul class="list-style-none stack-grid" style="gap: var(--base-size-16)">
      {posts.map((post) => (
        <li>
          <a href={`${base}blog/${post.id}/`} class="card-link">
            <h2 class="card-title h3 mb-1">{post.data.title || extractTitle(post.id)}</h2>
            {post.data.description && (
              <p class="color-fg-muted mb-2">{post.data.description}</p>
            )}
            <span class="color-fg-accent text-bold">
              Read more<span class="sr-only"> about {post.data.title || extractTitle(post.id)}</span>
              <Icon name="arrow-right" class="ml-1" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</BaseLayout>
