---
import { NAV_SECTIONS, STANDALONE_PAGES } from '../navigation';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside id="sidebar" class="docs-sidebar" aria-label="Documentation" data-pagefind-ignore>
  <div class="p-3">
    {NAV_SECTIONS.map((section) => (
      <nav class="mb-4" data-pagefind-ignore aria-labelledby={`nav-${section.dir}`}>
        <h2 id={`nav-${section.dir}`} class="f6 text-bold color-fg-muted text-uppercase px-3 mb-1">
          {section.title}
        </h2>
        <ul class="SideNav list-style-none">
          {section.items.map((item) => (
            <li>
              <a
                href={`${base}docs/${item.slug}/`}
                class="SideNav-item"
                aria-current={currentSlug === item.slug ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}

    <nav class="border-top pt-3" data-pagefind-ignore aria-label="More documentation">
      <ul class="SideNav list-style-none">
        {STANDALONE_PAGES.map((page) => (
          <li>
            <a
              href={`${base}docs/${page.slug}/`}
              class="SideNav-item"
              aria-current={currentSlug === page.slug ? 'page' : undefined}
            >
              {page.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>

<div id="sidebar-overlay" class="sidebar-overlay" hidden></div>

<script>
  const SIDEBAR_SCROLL_KEY = 'squad-docs-sidebar-scroll';

  function getSidebar() {
    return document.getElementById('sidebar');
  }

  let lastScrollTop = 0;
  let rafPending = false;

  function trackSidebarScroll() {
    const sidebar = getSidebar();
    if (!sidebar) return;

    if (!rafPending) {
      rafPending = true;
      requestAnimationFrame(() => {
        lastScrollTop = sidebar.scrollTop;
        rafPending = false;
      });
    }
  }

  function flushSidebarScroll() {
    const sidebar = getSidebar();
    if (sidebar) {
      lastScrollTop = sidebar.scrollTop;
    }
    sessionStorage.setItem(SIDEBAR_SCROLL_KEY, String(lastScrollTop));
  }

  function restoreSidebarScroll() {
    const sidebar = getSidebar();
    if (!sidebar) return false;

    const savedScrollTop = sessionStorage.getItem(SIDEBAR_SCROLL_KEY);
    if (savedScrollTop === null) return false;

    const scrollTop = Number(savedScrollTop);
    if (Number.isNaN(scrollTop)) return false;

    sidebar.scrollTop = scrollTop;
    lastScrollTop = scrollTop;
    return true;
  }

  function initSidebar() {
    const sidebar = getSidebar();
    if (!sidebar) return;

    if (!sidebar.dataset.scrollPersistenceBound) {
      sidebar.addEventListener('scroll', trackSidebarScroll, { passive: true });
      sidebar.dataset.scrollPersistenceBound = 'true';
    }

    requestAnimationFrame(() => {
      const restoredScroll = restoreSidebarScroll();
      if (restoredScroll) return;

      const activeLink = sidebar.querySelector('[aria-current="page"]');
      activeLink?.scrollIntoView({ block: 'center', behavior: 'instant' });
    });
  }

  if (!window.__squadDocsSidebarStateSetup) {
    document.addEventListener('astro:before-preparation', flushSidebarScroll);
    document.addEventListener('astro:after-swap', initSidebar);
    document.addEventListener('astro:page-load', initSidebar);
    window.addEventListener('pagehide', flushSidebarScroll);
    window.__squadDocsSidebarStateSetup = true;
  }

  initSidebar();
</script>
