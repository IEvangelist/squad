---
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL;

const suggestions = [
  { title: 'Install Squad', path: 'Get Started', href: `${base}docs/get-started/installation/`, icon: '🚀' },
  { title: 'CLI reference', path: 'Reference', href: `${base}docs/reference/cli/`, icon: '📖' },
  { title: 'Skills system', path: 'Core Features', href: `${base}docs/features/skills/`, icon: '🧠' },
  { title: 'What’s new', path: 'Docs', href: `${base}docs/whatsnew/`, icon: '✨' },
];
---

<button
  id="search-btn"
  type="button"
  class="btn btn-sm search-trigger d-flex flex-items-center"
  aria-haspopup="dialog"
  aria-keyshortcuts="Control+K Meta+K"
>
  <Icon name="search" class="mr-md-2" />
  <span class="d-none d-md-inline color-fg-muted">Search docs...</span><span class="sr-only d-md-none">Search docs...</span>
  <kbd class="d-none d-md-inline-block ml-auto" id="search-shortcut-kbd"><span id="search-modifier">Ctrl+</span>K</kbd>
</button>

<dialog id="search-modal" class="search-dialog" aria-label="Search documentation">
  <div id="search-backdrop" class="search-backdrop">
    <div class="search-panel">
      <div class="search-input-row">
        <Icon name="search" size={20} class="search-icon" />
        <input
          id="search-input"
          type="text"
          class="search-input"
          placeholder="Search the docs and blog…"
          aria-label="Search documentation"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        />
        <span class="search-spinner" id="search-spinner" aria-hidden="true" hidden></span>
        <button type="button" class="btn btn-sm" id="search-close-kbd" aria-label="Close search">Esc</button>
      </div>
      <div id="search-status" class="search-status" role="status" aria-live="polite" hidden></div>
      <div id="search-empty" class="search-empty search-results">
        <p class="mono-label mb-2">Jump to</p>
        <ul class="list-style-none">
          {suggestions.map((s) => (
            <li>
              <a href={s.href} class="search-result search-suggestion">
                <span class="search-glyph" aria-hidden="true">{s.icon}</span>
                <span class="search-result-main">
                  <span class="search-result-title">{s.title}</span>
                  <span class="search-path">{s.path}</span>
                </span>
                <Icon name="arrow-right" class="search-enter" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div id="search-results" class="search-results"></div>
      <div class="search-footer" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
        <span><kbd>↵</kbd> open</span>
        <span><kbd>esc</kbd> close</span>
        <span class="ml-auto">Search by Pagefind</span>
      </div>
    </div>
  </div>
</dialog>

<script define:vars={{ base }}>
  // Pagefind instance persists across View Transitions - no need to re-import
  let pagefind = null;

  async function loadPagefind() {
    if (pagefind) return pagefind;
    pagefind = await import(`${base}pagefind/pagefind.js`);
    await pagefind.init();
    return pagefind;
  }

  // Section badges use Primer color utilities (static, no DOM dependency)
  const SECTION_COLORS = {
    'Get Started': 'color-bg-success-emphasis color-fg-on-emphasis',
    'Concepts': 'color-bg-danger-emphasis color-fg-on-emphasis',
    'Core Features': 'color-bg-done-emphasis color-fg-on-emphasis',
    'Advanced Features': 'color-bg-sponsors-emphasis color-fg-on-emphasis',
    'Infrastructure': 'color-bg-severe-emphasis color-fg-on-emphasis',
    'Guides': 'color-bg-accent-emphasis color-fg-on-emphasis',
    'Security': 'color-bg-attention-emphasis color-fg-on-emphasis',
    'Scenarios': 'color-bg-accent-emphasis color-fg-on-emphasis',
    'Reference': 'color-bg-attention-emphasis color-fg-on-emphasis',
    'Blog': 'color-bg-subtle color-fg-default border',
  };
  const SECTION_GLYPH = {
    'Get Started': '🚀', 'Concepts': '💡', 'Core Features': '🧠', 'Advanced Features': '⚙️', 'Infrastructure': '🏗️',
    'Guides': '📘', 'Security': '🛡️', 'Scenarios': '🗺️', 'Reference': '📖', 'Blog': '✍️',
  };

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function getSectionBadge(section) {
    if (!section) return '';
    const colors = SECTION_COLORS[section] || 'color-bg-subtle color-fg-default border';
    return `<span class="search-badge d-inline-flex f6 text-bold px-2 rounded-2 ${colors}">${escapeHtml(section)}</span>`;
  }

  // Readable breadcrumb from a result URL: /squad/docs/features/skills/ -> features › skills
  function pathFromUrl(url) {
    const clean = url.replace(base, '').replace(/^\/+|\/+$/g, '').replace(/\.html$/, '');
    return clean.split('/').filter((s) => s !== 'docs').join(' › ');
  }

  // --- DOM-dependent state, refreshed on each navigation ---
  let searchBtn, searchModal, searchBackdrop, searchInput,
      searchResults, searchEmpty, searchCloseBtn, searchStatus, searchSpinner;
  let debounceTimer, searchToken = 0, activeIndex = -1;

  // Bound handler refs so we can removeEventListener cleanly
  let _onBtnClick, _onBackdropClick, _onCloseClick, _onInput, _onDialogClose, _onInputKey, _onResultsKey;

  const options = () => Array.from(searchModal?.querySelectorAll('.search-panel a.search-result') ?? []).filter((el) => !el.closest('[hidden]'));

  // Highlights a result; with focus=true, moves keyboard focus onto it (arrow-key navigation)
  function setActive(index, focus = false) {
    const items = options();
    if (!items.length) { activeIndex = -1; return; }
    activeIndex = Math.max(0, Math.min(index, items.length - 1));
    items.forEach((el, i) => el.classList.toggle('is-active', i === activeIndex));
    const el = items[activeIndex];
    if (focus) el.focus();
    el.scrollIntoView({ block: 'nearest' });
  }
  function openSearch() {
    if (!searchModal || searchModal.open) return;
    searchModal.showModal();
    searchInput?.focus();
    setActive(0);
  }

  function resetSearch() {
    searchToken++;
    if (searchInput) searchInput.value = '';
    if (searchResults) searchResults.innerHTML = '';
    if (searchEmpty) searchEmpty.hidden = false;
    if (searchStatus) searchStatus.hidden = true;
    if (searchSpinner) searchSpinner.hidden = true;
    setActive(0);
  }
  function closeSearch() {
    if (searchModal?.open) searchModal.close();
  }

  async function performSearch() {
    const query = searchInput?.value?.trim();
    if (!query) {
      resetSearch();
      return;
    }

    const token = ++searchToken;
    if (searchSpinner) searchSpinner.hidden = false;
    try {
      const pf = await loadPagefind();
      const search = await pf.search(query);
      const results = await Promise.all(search.results.slice(0, 10).map((r) => r.data()));
      if (token !== searchToken || !searchResults) return;

      searchResults.innerHTML = '';
      if (searchEmpty) searchEmpty.hidden = true;
      if (searchSpinner) searchSpinner.hidden = true;

      if (results.length === 0) {
        const noResults = document.createElement('div');
        noResults.className = 'search-empty search-none';
        noResults.innerHTML = `<p class="f3 mb-1">No results for “${escapeHtml(query)}”</p><p class="color-fg-muted mb-0">Try a different keyword, or browse the <a href="${base}docs/get-started/installation/">docs</a> and the <a href="${base}blog/">blog</a>.</p>`;
        searchResults.appendChild(noResults);
        if (searchStatus) searchStatus.hidden = true;
        setActive(-1);
        return;
      }

      if (searchStatus) {
        searchStatus.textContent = `${search.results.length} result${search.results.length === 1 ? '' : 's'}`;
        searchStatus.hidden = false;
      }

      results.forEach((result) => {
        const section = result.meta?.section || '';
        const a = document.createElement('a');
        a.href = result.url;
        a.className = 'search-result';
        // Pagefind excerpts contain trusted <mark> highlights generated from indexed content
        a.innerHTML = `
          <span class="search-glyph" aria-hidden="true">${SECTION_GLYPH[section] || '📄'}</span>
          <span class="search-result-main">
            <span class="d-flex flex-items-center" style="gap: var(--base-size-8)">
              <span class="search-result-title">${escapeHtml(result.meta?.title || 'Untitled')}</span>
              ${getSectionBadge(section)}
            </span>
            <span class="search-path">${escapeHtml(pathFromUrl(result.url))}</span>
            <div class="search-excerpt">${result.excerpt || ''}</div>
          </span>
          <svg class="octicon search-enter" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8.22 2.97a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042l2.97-2.97H3.75a.75.75 0 0 1 0-1.5h7.44L8.22 4.03a.75.75 0 0 1 0-1.06Z"></path></svg>`;
        // Close dialog on click - navigation proceeds via View Transitions
        a.addEventListener('click', closeSearch);
        a.addEventListener('mousemove', () => { const i = options().indexOf(a); if (i !== activeIndex) setActive(i); });
        searchResults.appendChild(a);
      });
      setActive(0);
    } catch {
      if (searchSpinner) searchSpinner.hidden = true;
      if (searchResults) {
        if (searchEmpty) searchEmpty.hidden = true;
        searchResults.innerHTML = '<div class="search-empty">Search index loading…</div>';
      }
    }
  }

  // Global keydown - register exactly once, never duplicated
  let _globalKeydownRegistered = false;
  function handleGlobalKeydown(e) {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (searchModal?.open) {
        closeSearch();
      } else {
        openSearch();
      }
    }
  }

  function initSearch() {
    clearTimeout(debounceTimer);

    // Tear down old element listeners (old refs may be detached)
    if (_onBtnClick && searchBtn) searchBtn.removeEventListener('click', _onBtnClick);
    if (_onBackdropClick && searchBackdrop) searchBackdrop.removeEventListener('click', _onBackdropClick);
    if (_onCloseClick && searchCloseBtn) searchCloseBtn.removeEventListener('click', _onCloseClick);
    if (_onInput && searchInput) searchInput.removeEventListener('input', _onInput);
    if (_onInputKey && searchInput) searchInput.removeEventListener('keydown', _onInputKey);
    if (_onDialogClose && searchModal) searchModal.removeEventListener('close', _onDialogClose);
    if (_onResultsKey && searchResults) searchResults.removeEventListener('keydown', _onResultsKey);

    // Re-query all DOM elements (fresh references after View Transition swap)
    searchBtn = document.getElementById('search-btn');
    searchModal = document.getElementById('search-modal');
    searchBackdrop = document.getElementById('search-backdrop');
    searchInput = document.getElementById('search-input');
    searchResults = document.getElementById('search-results');
    searchEmpty = document.getElementById('search-empty');
    searchCloseBtn = document.getElementById('search-close-kbd');
    searchStatus = document.getElementById('search-status');
    searchSpinner = document.getElementById('search-spinner');

    const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform);
    const modifierEl = document.getElementById('search-modifier');
    if (modifierEl) {
      modifierEl.textContent = isMac ? 'Cmd+' : 'Ctrl+';
    }

    _onBtnClick = () => openSearch();
    // Only clicks on the backdrop itself (outside the panel) dismiss the dialog
    _onBackdropClick = (e) => { if (e.target === searchBackdrop) closeSearch(); };
    _onCloseClick = () => closeSearch();
    _onDialogClose = () => resetSearch();
    _onInput = () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => performSearch(), 150);
    };
    _onInputKey = (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.max(activeIndex, 0), true); }
      else if (e.key === 'Enter') {
        const el = options()[activeIndex];
        if (el) { e.preventDefault(); el.click(); }
      } else if (e.key === 'Escape' && searchInput.value) {
        // First Escape clears the query; a second closes the dialog
        e.preventDefault();
        resetSearch();
      }
    };

    searchBtn?.addEventListener('click', _onBtnClick);
    searchBackdrop?.addEventListener('click', _onBackdropClick);
    searchCloseBtn?.addEventListener('click', _onCloseClick);
    searchInput?.addEventListener('input', _onInput);
    searchInput?.addEventListener('keydown', _onInputKey);
    searchModal?.addEventListener('close', _onDialogClose);
    // Arrow keys move focus between result links; ArrowUp from the first returns to the input
    _onResultsKey = (e) => {
      const items = options();
      const i = items.indexOf(document.activeElement);
      if (i < 0) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(i + 1, true); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); if (i === 0) { searchInput.focus(); } else { setActive(i - 1, true); } }
    };
    searchResults?.addEventListener('keydown', _onResultsKey);
    searchResults?.addEventListener('focusin', (e) => { const i = options().indexOf(e.target); if (i >= 0) setActive(i); });
    // Suggestions are links in the initial markup; make them close the dialog on click
    options().forEach((a) => a.addEventListener('click', closeSearch));

    if (!_globalKeydownRegistered) {
      document.addEventListener('keydown', handleGlobalKeydown);
      _globalKeydownRegistered = true;
    }
  }

  // astro:page-load fires on initial load AND after each View Transition
  document.addEventListener('astro:page-load', initSearch);
</script>
