---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { NAV_SECTIONS } from '../navigation';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
  updatedAt?: Date;
  prevPage?: { title: string; slug: string } | null;
  nextPage?: { title: string; slug: string } | null;
}

const { title, description, currentSlug, updatedAt, prevPage, nextPage } = Astro.props;

// Derive section name from the URL path for Pagefind metadata
const sectionDir = currentSlug?.split('/')[0] || '';
const navSection = NAV_SECTIONS.find(s => s.dir === sectionDir);
const section = navSection?.title || 'Docs';

const editUrl = currentSlug
  ? `https://github.com/github/squad/edit/dev/docs/src/content/docs/${currentSlug}.md`
  : null;
---

<BaseLayout title={title} description={description}>
  <Header />
  <div class="docs-layout">
    <Sidebar currentSlug={currentSlug} />
    <main id="main-content" class="docs-main" tabindex="-1">
      <div class="container-xl mx-auto px-3 px-md-4 py-4 py-md-5">
        <div class="d-lg-flex" style="gap: var(--base-size-32)">
          <div class="flex-1 min-width-0" style="min-width: 0; max-width: 56rem">
            <article class="markdown-body" data-pagefind-body data-pagefind-meta={`section:${section}`}>
              <slot />
            </article>

            {updatedAt && (
              <p class="mt-4 f6 color-fg-muted">
                Last updated: {updatedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
            )}

            {(prevPage || nextPage) && (
              <nav class="mt-5 pt-4 border-top d-flex flex-justify-between" style="gap: var(--base-size-16)" aria-label="Page navigation" data-pagefind-ignore>
                {prevPage ? (
                  <a href={`${import.meta.env.BASE_URL}docs/${prevPage.slug}/`} class="btn" rel="prev">
                    <Icon name="arrow-left" class="mr-2" />{prevPage.title}
                  </a>
                ) : <span />}
                {nextPage && (
                  <a href={`${import.meta.env.BASE_URL}docs/${nextPage.slug}/`} class="btn ml-auto" rel="next">
                    {nextPage.title}<Icon name="arrow-right" class="ml-2" />
                  </a>
                )}
              </nav>
            )}

            {editUrl && (
              <div class="mt-4 pt-3 border-top" data-pagefind-ignore>
                <a
                  href={editUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="edit-this-page link-muted f6"
                >
                  <Icon name="pencil" class="mr-1" />Edit this page on GitHub
                </a>
              </div>
            )}
          </div>

          <aside class="d-none d-lg-block flex-shrink-0" style="width: 14rem" aria-label="Table of contents" data-pagefind-ignore>
            <TableOfContents />
          </aside>
        </div>
      </div>
      <Footer />
    </main>
  </div>
</BaseLayout>

